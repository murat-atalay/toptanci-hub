<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ToptanciHub.ViewModels"
             x:Class="ToptanciHub.Views.MainPage"
             x:DataType="viewmodels:MainViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Image
                Source="dotnet_bot.svg"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="Toptancı Hub logosu" />

            <Label
                Text="{Binding WelcomeMessage}"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1"
                HorizontalOptions="Center" />

            <Label
                Text="B2B Sosyal E-Ticaret Platformu"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2"
                HorizontalOptions="Center"
                Margin="0,0,0,20" />

            <Border 
                Padding="20"
                BackgroundColor="{StaticResource CardBackground}"
                StrokeThickness="0"
                Margin="0,10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="15">
                    <Label
                        Text="Platform Özellikleri"
                        FontAttributes="Bold"
                        FontSize="18"
                        Margin="0,0,0,10"/>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="✓" FontSize="20" TextColor="{StaticResource Primary}"/>
                        <Label Text="Kampanya Yönetimi" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="✓" FontSize="20" TextColor="{StaticResource Primary}"/>
                        <Label Text="Ürün Katalogları" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="✓" FontSize="20" TextColor="{StaticResource Primary}"/>
                        <Label Text="Fiyat Teklifi Sistemi" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="✓" FontSize="20" TextColor="{StaticResource Primary}"/>
                        <Label Text="Kademeli Fiyatlandırma" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="✓" FontSize="20" TextColor="{StaticResource Primary}"/>
                        <Label Text="Sosyal Etkileşim" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Button
                Text="Veri Yükle"
                Command="{Binding LoadDataCommand}"
                HorizontalOptions="Fill"
                Margin="0,20,0,0"/>

            <ActivityIndicator 
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="{StaticResource Primary}"
                HeightRequest="50"/>

            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                TextColor="{StaticResource Tertiary}"
                HorizontalOptions="Center"
                Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
