<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Material Design Blue Theme Colors -->
    
    <!-- Primary Colors -->
    <Color x:Key="Primary">#1976D2</Color>
    <Color x:Key="PrimaryDark">#0D47A1</Color>
    <Color x:Key="PrimaryLight">#BBDEFB</Color>
    
    <!-- Secondary Colors -->
    <Color x:Key="Secondary">#424242</Color>
    <Color x:Key="SecondaryDark">#212121</Color>
    <Color x:Key="SecondaryLight">#757575</Color>
    
    <!-- Accent Colors -->
    <Color x:Key="Tertiary">#FF5252</Color>
    <Color x:Key="TertiaryDark">#D32F2F</Color>
    <Color x:Key="TertiaryLight">#FFCDD2</Color>
    
    <!-- Background Colors -->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Gray100">#FAFAFA</Color>
    <Color x:Key="Gray200">#F5F5F5</Color>
    <Color x:Key="Gray300">#EEEEEE</Color>
    <Color x:Key="Gray400">#BDBDBD</Color>
    <Color x:Key="Gray500">#9E9E9E</Color>
    <Color x:Key="Gray600">#757575</Color>
    <Color x:Key="Gray900">#212121</Color>

    <!-- Text Colors -->
    <Color x:Key="TextPrimary">#212121</Color>
    <Color x:Key="TextSecondary">#757575</Color>
    <Color x:Key="TextHint">#9E9E9E</Color>
    <Color x:Key="TextLight">#FFFFFF</Color>

    <!-- Status Colors -->
    <Color x:Key="Success">#4CAF50</Color>
    <Color x:Key="Warning">#FF9800</Color>
    <Color x:Key="Error">#F44336</Color>
    <Color x:Key="Info">#2196F3</Color>

    <!-- UI Element Colors -->
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="PageBackground">#FAFAFA</Color>
    <Color x:Key="DividerColor">#E0E0E0</Color>
    <Color x:Key="OverlayBackground">#80000000</Color>

    <!-- Light/Dark Theme Support -->
    <Color x:Key="Background"
           Light="{StaticResource Gray100}"
           Dark="{StaticResource Gray900}"/>
    
    <Color x:Key="Surface"
           Light="{StaticResource White}"
           Dark="{StaticResource Gray600}"/>

</ResourceDictionary>
